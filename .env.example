## Database (Turso / libSQL)
TURSO_CONNECTION_URL=libsql://your-db-url.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

## Admin passphrase for /admin
ADMIN_PASSPHRASE=change-me

## Admin allowlist (comma-separated emails)
ADMIN_EMAILS=alice@example.com,bob@example.com

## NextAuth (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## NextAuth settings
# For local dev, keep this as http://localhost:3000
NEXTAUTH_URL=https://adacademilite.vercel.app
# Generate with: npx auth secret  (or any strong random string)
NEXTAUTH_SECRET=change-me

